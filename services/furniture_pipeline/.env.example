# Relative paths are resolved from the 3DProperty repository root.
# Optional: absolute paths on your Runyour persistent volume.
PIPELINE_RUNTIME_DIR=runtime/furniture
PIPELINE_HF_HOME=runtime/model-cache
PIPELINE_SAM3_PYTHON=.envs/furniture-sam3/bin/python
PIPELINE_MOGE3_PYTHON=.envs/furniture-moge3/bin/python
PIPELINE_SETTINGS_FILE=services/furniture_pipeline/settings.json
# Blank: download facebook/sam3 after scripts/login_hf.sh.
PIPELINE_SAM3_CHECKPOINT=
PIPELINE_MOGE_CHECKPOINT=Ruicheng/moge-3-vitl
# One-time install: bash services/furniture_pipeline/scripts/setup_supermat.sh
PIPELINE_SUPERMAT_PYTHON=.envs/furniture-supermat/bin/python
PIPELINE_SUPERMAT_CHECKPOINT=SuperMat/checkpoints/supermat.pth
# Hugging Face repository ID, or an absolute / repository-relative local directory.
PIPELINE_SUPERMAT_BASE_MODEL=sd2-community/stable-diffusion-2-1
PIPELINE_SUPERMAT_DEVICE=cuda
# Multiple of 8, between 64 and 2048.
PIPELINE_SUPERMAT_IMAGE_SIZE=512
# Per model process, including first-time downloads (seconds).
PIPELINE_WORKER_TIMEOUT=1800
PIPELINE_API_HOST=127.0.0.1
PIPELINE_API_PORT=8000
PIPELINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SuperMat prompt + selected code provider + Blender. False keeps measurement only.
PIPELINE_GENERATE_3D=true
# Real GPT on this branch. Use stub explicitly for the previous fixed test table.
PIPELINE_CODE_PROVIDER=services.furniture_pipeline.pipeline.gpt_provider:generate
# Server only. Put the actual key in .env (ignored by Git), never in this example.
OPENAI_API_KEY=
PIPELINE_GPT_MODEL=gpt-6-astra
# extra high = xhigh. Do not add temperature/top_p for GPT-6 Astra.
PIPELINE_GPT_REASONING_EFFORT=xhigh
# Includes reasoning + visible output tokens.
PIPELINE_GPT_MAX_OUTPUT_TOKENS=32768
# Per API attempt; SDK retries are disabled.
PIPELINE_GPT_TIMEOUT=900
PIPELINE_BLENDER_EXECUTABLE=.tooling/blender/blender
# Blender export time budget for the single test furniture per image.
PIPELINE_BLENDER_TIMEOUT=120
